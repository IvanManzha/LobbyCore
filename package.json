{
  "name": "pubg-tournament-app",
  "version": "1.0.0",
  "main": "src/backend/server.js",
  "scripts": {
    "test": "npm run test:all",
    "test:setup": "node -e \"require('./src/backend/tests/helpers/testDb').migrateAndSeed().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "db:migrate:test": "cross-env KNEX_ENV=test knex migrate:latest",
    "test:stats": "node --test -r ts-node/register src/stats/tests/computePlayerStats.test.ts",
    "test:backend": "npm run test:setup && node --test --test-concurrency=1 test/backend src/backend/tests",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test",
    "test:smoke": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright playwright test --grep @smoke",
    "test:all": "npm run test:stats && npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:frontend": "cd src/frontend && npm run test",
    "start": "node src/backend/server.js",
    "start:legacy": "node server.js",
    "start:new": "node src/backend/server.js",
    "db:migrate": "knex migrate:latest",
    "db:migrate:prod": "cross-env NODE_ENV=production knex migrate:latest",
    "db:init-app": "node scripts/init_app_db.js",
    "verify:prod-readiness": "node scripts/verify-production-readiness.js",
    "dev": "nodemon --watch server.js --watch scripts --watch public --ignore data/ server.js",
    "dev:new": "nodemon",
    "kill:ports": "node scripts/kill-ports.js",
    "dev:all": "npm run kill:ports && concurrently \"npm run dev:new\" \"npm run frontend:dev\"",
    "frontend:dev": "cd src/frontend && npm run dev",
    "frontend:build": "cd src/frontend && npm run build",
    "bot": "node bot.js",
    "add-team": "node scripts/addTeam.js",
    "update-result": "echo '⚠️ DEPRECATED: Результаты обновляются автоматически' && node scripts/updateResult.js",
    "delete-team": "node scripts/deleteTeam.js",
    "calc-leaderboard": "node scripts/calcLeaderboard.js",
    "clear-table": "node scripts/clearTeams.js",
    "update-kills": "echo '⚠️ DEPRECATED: Киллы обновляются автоматически' && node scripts/updatePlayerKills.js",
    "update-active": "node scripts/updateActiveTournament.js",
    "rebuild-player-histories": "node scripts/rebuildPlayerHistories.js",
    "apply-rating_v2": "node scripts/addRating_v2.js",
    "add-rating": "node scripts/addRating.js",
    "apply-rating": "node scripts/applyRatings.js",
    "count_rating2": "node scripts/calcEffectiveRating",
    "get_LastMatch_id": "node scripts/db_scripts/get_Latest_Match.js",
    "maps:download": "node scripts/download-pubg-maps.js",
    "fetch_match": "echo '⚠️ DEPRECATED: Используйте автоматический мониторинг через UI' && node scripts/db_scripts/fetch_And_Save_Match.js",
    "fetch-dna-test": "node scripts/db_scripts/fetch_Last_Match_To_DnaTest.js",
    "fetch-dna-test-3": "node scripts/db_scripts/fetch_Last3_Matches_To_DnaTest.js",
    "clear-db": "node scripts/db_scripts/clear_Db.js",
    "db-Lastmatch-stats": "node scripts/db_scripts/get_Last_Match_Stats.js",
    "ingest:match": "node scripts/ingestMatchFull.js",
    "ingest:reingest-all": "node scripts/reingestAllMatches.js",
    "dna-test:sync": "node scripts/db_scripts/syncDnaTestWithPipeline.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "JSONStream": "^1.3.5",
    "archiver": "^7.0.1",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "density-clustering": "^1.3.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "ngrok": "^5.0.0-beta.2",
    "nodemailer": "^7.0.12",
    "pip": "^0.0.1",
    "sqlite3": "^5.1.7",
    "steam-signin": "^1.0.5",
    "steamid": "^2.1.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.0.10",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.7.4+sha512.fdb4396d7a7c97b92b866d905d0546b8f8f3342fd9fe9d1f2b8930f1a22ba86d18b614d2f5a9112861e25b26875fadb7967b42ae21c16593ea85b5dccea48d56"
}
